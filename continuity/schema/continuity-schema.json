{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.example/schemas/continuity-schema.json",
  "title": "Nexus Continuity Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "entities",
    "relationships",
    "reentryQuery",
    "expectedFindings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "reentryQuery": {
      "$ref": "#/$defs/reentryQuery"
    },
    "expectedFindings": {
      "$ref": "#/$defs/expectedFindings"
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "disputed",
        "superseded",
        "stale",
        "unverified",
        "open",
        "blocked",
        "in_progress",
        "completed",
        "archived"
      ]
    },
    "entityType": {
      "type": "string",
      "enum": [
        "source",
        "evidence",
        "claim",
        "decision",
        "task",
        "risk",
        "agent_memory",
        "owner",
        "event",
        "outcome"
      ]
    },
    "relationshipType": {
      "type": "string",
      "enum": [
        "derived_from",
        "supports",
        "contradicts",
        "influences",
        "depends_on",
        "assigned_to",
        "supersedes",
        "produces",
        "blocks",
        "resolves",
        "recorded_by"
      ]
    },
    "providerSource": {
      "type": "object",
      "required": [
        "provider",
        "reference"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "description",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "title",
        "summary",
        "status",
        "createdAt",
        "updatedAt",
        "source",
        "confidence",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/providerSource"
        },
        "ownerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmedBy": {
          "type": "string"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes": {
          "type": "string"
        },
        "supersededBy": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "string"
        },
        "completionCriteria": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "from",
        "to",
        "createdAt",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/relationshipType"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "reentryQuery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "question",
        "requestedAt"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expectedFindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaningfulChanges",
        "staleRecords",
        "agentConflicts",
        "missingOwners",
        "validDecisions",
        "recommendedActions"
      ],
      "properties": {
        "meaningfulChanges": {
          "type": "integer",
          "minimum": 0
        },
        "staleRecords": {
          "type": "integer",
          "minimum": 0
        },
        "agentConflicts": {
          "type": "integer",
          "minimum": 0
        },
        "missingOwners": {
          "type": "integer",
          "minimum": 0
        },
        "validDecisions": {
          "type": "integer",
          "minimum": 0
        },
        "recommendedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
